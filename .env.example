PORT=3001
# 默认只监听本机。使用同机 HTTPS 反代时通常仍保持 127.0.0.1；只有确需直接对外监听时才改 0.0.0.0。
HOST=127.0.0.1
# 非 loopback 监听时至少 32 字符。建议：openssl rand -hex 32
AUTH_TOKEN=

WORK_DIR=/Users/you/projects
# 额外工作区白名单：逗号分隔的目录，或指向 JSON 数组文件（如 workdirs.json）
WORK_DIRS=
CODEX_BIN=
# 可选的部署状态目录；设备、Push 和审计文件均写入这里
CODEX_DATA_DIR=

IDLE_TIMEOUT_MS=600000
CODEX_INPUT_QUEUE_LIMIT=20
CODEX_EVENT_BUFFER_CAP=500
# 审批策略：untrusted|on-failure|on-request|granular|never
CODEX_APPROVAL_POLICY=on-request
# 沙箱：read-only|workspace-write|danger-full-access
CODEX_SANDBOX=workspace-write

# 远程浏览器安全策略。Origin 必须写完整 origin，不支持 *。
CODEX_ALLOWED_ORIGINS=
# 只有这些直接对端 IP 的 X-Forwarded-Proto 会被信任；不支持 CIDR/hostname。
CODEX_TRUSTED_PROXY_IPS=
# 危险的开发逃生口；生产和手机访问保持 0。
CODEX_ALLOW_INSECURE_REMOTE=0
CODEX_SESSION_TTL_MS=604800000
CODEX_AUTH_MAX_FAILURES=5
CODEX_AUTH_WINDOW_MS=60000
# security-audit.jsonl 的活跃文件字节上限；达到后只保留一份 .1 轮转。
CODEX_SECURITY_AUDIT_MAX_BYTES=1048576
CODEX_PENDING_DEVICE_LIMIT=32

# 空闲 runtime 回收：非 busy、无待决审批、队列为空、无 command/exec 进程在跑、
# 且没有任何 socket 在看它，超过这个时长才回收。回收的只是网关侧的壳——thread 的
# 事实源在 app-server，重连后 thread:select 会重建，代价是断了 catch-up 的增量续传
# （要走一次 thread/read 全量重建）。手机常常锁屏几小时，若觉得 30 分钟偏短可以调大；
# 低于 60000 的值会被当作误配忽略并回落到默认值。
CODEX_AGENT_IDLE_TTL_MS=1800000

# RPC 观测日志（工作目录下的 .codex-chat-rpc.jsonl，owner-only）。设为 0 完全关闭；
# 超过大小上限后轮转到 .1，只保留一代。
CODEX_RPC_LOG=1
CODEX_RPC_LOG_MAX_BYTES=8388608

# 远程 HTTPS 图片输入默认关闭；开启后仍执行 URL、DNS 和 SSRF 校验。
CODEX_ALLOW_REMOTE_IMAGES=0

# 向 app-server 声明 capabilities.experimentalApi。只影响 collaborationMode
# (thread/settings/update) 是否可用；变量名是历史遗留（Labs 面板已删除）。
CODEX_P3_EXPERIMENTAL=0

# Web Push（可选）：三项齐全才启用；订阅还要求 HTTPS、安全 session 和已批准设备；投递会重新校验公网 DNS 并 pin 地址。
CODEX_PUSH_MAX_SUBSCRIPTIONS=64
# VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
